# ---------------------------------------------------------------------------
# 22scores environment configuration
# Copy this file to `.env.local` (Next.js) / `.env` (drizzle-kit) and fill in.
# NEVER commit real secrets. Only DATABASE_URL is required for the foundation.
# ---------------------------------------------------------------------------

# --- Database (Supabase Postgres) -----------------------------------------
# Use the Supabase connection string. For app runtime prefer the pooled
# ("Transaction"/Supavisor) connection; for drizzle-kit migrations use the
# direct ("Session") connection.
DATABASE_URL="postgresql://postgres:password@localhost:5432/22scores"

# --- App ------------------------------------------------------------------
# Public base URL of the site (used later for SEO/canonical URLs).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Sports data providers.
# No keys are used yet — these are placeholders so the provider abstraction
# has a documented home for credentials when ingestion is implemented later.
# Leave blank for now. Providers that need no key (Lichess, Chess.com) are
# listed only for the optional contact User-Agent they recommend.
# ---------------------------------------------------------------------------

# Cricket — TheSportsDB (free test key works without signup; premium optional).
THESPORTSDB_API_KEY=""

# Cricket — CricketData (requires a free account; key from the account page).
CRICKETDATA_API_KEY=""

# Chess — Lichess (public API, no key required).
# Chess — Chess.com (public API, no key; a contact User-Agent is recommended).
PROVIDER_CONTACT_USER_AGENT="22scores (contact: you@example.com)"
